    {
      "name": "Get Missing Menu Item",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu/Hot%20Drinks/COF-999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 404 Not Found\", function () {",
