{
  "info": {
    "_postman_id": "4ba97f70-f065-4ef1-b038-a41e949d7979",
    "name": "CoffeeNChill Menu Tests",
    "description": "Postman tests for the CoffeeNChill menu Azure Functions API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7166/api"
    }
  ],
  "item": [
    {
      "name": "Create Cappuccino",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Hot Drinks\",\n  \"sku\": \"COF-001\",\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk and foam\",\n  \"price\": 42.50,\n  \"isAvailable\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains the correct SKU\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.rowKey).to.eql(\"COF-001\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Iced Coffee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Cold Drinks\",\n  \"sku\": \"CLD-001\",\n  \"name\": \"Iced Coffee\",\n  \"description\": \"Chilled coffee served over ice\",\n  \"price\": 37.50,\n  \"isAvailable\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Menu Items",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Hot Drinks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/Hot%20Drinks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Every item is a hot drink\", function () {",
              "    const items = pm.response.json();",
              "    items.forEach(item => {",
              "        pm.expect(item.partitionKey).to.eql(\"Hot Drinks\");",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Cappuccino",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu/Hot%20Drinks/COF-001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns Cappuccino\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.name).to.eql(\"Cappuccino\");",
              "    pm.expect(data.rowKey).to.eql(\"COF-001\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Cappuccino",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Large Cappuccino\",\n  \"description\": \"Double espresso with steamed milk and foam\",\n  \"price\": 49.99,\n  \"isAvailable\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/menu/Hot%20Drinks/COF-001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Price and name were updated\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.name).to.eql(\"Large Cappuccino\");",
              "    pm.expect(data.price).to.eql(49.99);",
              "});"
            ]
          }
        }
      ]
    },
    {
